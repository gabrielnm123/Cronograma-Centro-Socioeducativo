generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model UnidadeSocioeducativa {
 id String @id @default(cuid())
 nome String
 sigla String @unique
 turnos CronogramaTurno[]
 socioeducandos Socioeducando[]
}
model CronogramaTurno {
 id String @id @default(cuid())
 nome String
 unidadeId String
 unidade UnidadeSocioeducativa @relation(fields: [unidadeId], references: [id])
 areas AreaAtividade[]
 data DateTime @default(now())
}
model AreaAtividade {
 id String @id @default(cuid())
 nome String
 turnoId String
 turno CronogramaTurno @relation(fields: [turnoId], references: [id])
 colunas ColunaTurma[]
}
model ColunaTurma {
 id String @id @default(cuid())
 nome String
 horaInicio Int
 horaFim Int
 sala String
 professor String
 areaId String
 area AreaAtividade @relation(fields: [areaId], references: [id])
  alocacoes Alocacao[]
 @@index([horaInicio, horaFim])
}
model Socioeducando {
 id String @id @default(cuid())
 nome String
 turma String
 unidadeId String
 unidade UnidadeSocioeducativa @relation(fields: [unidadeId], references: [id])
  alocacoes Alocacao[]
}
model Alocacao {
 id String @id @default(cuid())
 turmaId String
 socioeducandoId String
 turma ColunaTurma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
 socioeducando Socioeducando @relation(fields: [socioeducandoId], references: [id], onDelete: Cascade)
 @@unique([turmaId, socioeducandoId])
}
